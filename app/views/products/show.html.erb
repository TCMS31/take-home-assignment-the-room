<% content_for :title, @product.title %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Products", products_path %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @product.title %></li>
  </ol>
</nav>

<article class="product-detail mb-4">
  <div class="row g-4">
    <div class="col-md-5 product-detail__media">
      <% if @product.image_url %>
        <%= image_tag @product.image_url, alt: @product.title %>
      <% end %>
    </div>
    <div class="col-md-7">
      <span class="badge-soft"><%= @product.category.to_s.titleize %></span>
      <h1 class="h3 mt-2 mb-1"><%= @product.title %></h1>
      <p class="text-muted mb-3"><%= @product.brand.presence || "Unbranded" %></p>
      <p><%= @product.description %></p>

      <div class="d-flex align-items-baseline flex-wrap gap-2 mb-3">
        <span class="product-detail__price"><%= number_to_currency(@product.discounted_price) %></span>
        <% if @product.discounted? %>
          <span class="product-detail__was"><%= number_to_currency(@product.price) %></span>
          <span class="badge-soft">
            Save <%= number_to_currency(@product.saving) %>
            (<%= number_with_precision(@product.discount_percentage, precision: 0) %>%)
          </span>
        <% end %>
      </div>

      <div class="d-flex gap-3">
        <span class="rating">&#9733; <%= @product.rating %> / 5</span>
        <span class="badge-soft <%= "stock-out" unless @product.in_stock? %>">
          <%= @product.in_stock? ? "#{@product.stock} in stock" : "Out of stock" %>
        </span>
      </div>
    </div>
  </div>
</article>

<%= render "comments" %>

<section class="mt-4">
  <h2 class="h5">Add a comment</h2>
  <%= form_with(model: @comment, class: "mt-2") do |form| %>
    <%= form.hidden_field :product_id %>
    <div class="mb-2">
      <%= form.label :message, "Your comment", class: "form-label" %>
      <%= form.text_area :message, class: "form-control", rows: 3,
            placeholder: "Share what you think about #{@product.title}" %>
    </div>
    <%= form.submit "Post comment", class: "btn btn-primary" %>
  <% end %>
</section>
