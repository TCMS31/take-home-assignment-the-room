# ---- Upstream catalogue ----------------------------------------------------
# Base URL of the product API. Optional; defaults to the public dummyjson host.
DUMMY_JSON_BASE_DOMAIN=https://dummyjson.com

# ---- Database --------------------------------------------------------------
# Leave DATABASE_ADAPTER unset for the local SQLite fallback (no server needed).
# Set it to "postgresql" to use PostgreSQL, as docker-compose.yml does.
# DATABASE_ADAPTER=postgresql
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=take_home_development
# DATABASE_USERNAME=take_home

# Required by docker-compose.yml. Choose your own value; never commit a real one.
DATABASE_PASSWORD=change_me

# ---- Rails -----------------------------------------------------------------
# Required in production / Docker. Generate with: bin/rails secret
SECRET_KEY_BASE=change_me

# Puma thread pool size, and the host port the compose stack publishes.
# RAILS_MAX_THREADS=5
# WEB_PORT=3000
